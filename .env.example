# Build-time public values (copy to .env). Inlined into the HTML — never put a secret here.
PUBLIC_SITE_URL=https://mboacm.com
# Turnstile site key (public). Leave empty in dev to use Cloudflare's always-pass test key.
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Web Analytics token (public). Empty = no analytics script.
PUBLIC_CF_ANALYTICS_TOKEN=
# API origin for the public document check (/verifier). Empty = production (https://api.mboacm.com).
# Staging: https://api-staging.mboacm.com — the API must allow this site's origin in mboa.cors.allowed-origins.
PUBLIC_API_BASE_URL=
